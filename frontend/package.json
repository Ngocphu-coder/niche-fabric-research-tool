{
  "name": "niche-fabric-research-tool",
  "version": "0.1.0",
  "description": "Multi-Platform Niche Fabric Product Research Tool",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "Ngocphu-coder",
  "license": "MIT",
  "scripts": {
    "dev": "react-scripts start",
    "start": "electron .",
    "build": "react-scripts build && electron-builder",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "dist": "electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "redux": "^4.2.1",
    "react-redux": "^8.1.3",
    "axios": "^1.6.2",
    "antd": "^5.11.2",
    "react-icons": "^4.12.0",
    "electron-store": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.0.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "productName": "Niche Fabric Research Tool",
    "appId": "com.ngocphu.fabric-research-tool",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
